{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Smart API Gateway",
  "version": "0.8.42",
  "identifier": "com.smart-api-gateway.app",
  "build": {
    "beforeDevCommand": "pnpm dev:renderer",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build:renderer",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Smart API Gateway",
        "width": 1100,
        "height": 750,
        "minWidth": 800,
        "minHeight": 600,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
